# Optional: set to "true" to disable Vite HMR (useful behind some proxies or sandboxes).
# DISABLE_HMR=

# Web3Forms access key (notifications go to the email linked in your Web3Forms account).
# VITE_WEB3FORMS_ACCESS_KEY=bb7e2b1d-31d9-4769-9674-4e1d4edafdcb

# HostPilot license protection (required in production)
# Upstream API origin used by the Vite/Vercel proxy (browser calls same-origin /api/license/check)
VITE_LICENSE_API_URL=https://api.eranovatechnologies.com
# Paste the license key from HostPilot admin → Licenses for this exact website domain
VITE_LICENSE_KEY=
# Optional; defaults to 1.0.0 if unset
VITE_APP_VERSION=1.0.0
